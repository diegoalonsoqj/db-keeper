# DBKeeper — variables de entorno (bootstrap mínimo, ver spec §13).
# Copia este archivo a `.env` y completa los valores. NUNCA subas `.env` al repo.
# Todo lo demás (credenciales de instancias, SMTP, Telegram, gcloud) vive cifrado en la BD.

# --- Aplicación ---
APP_ENV=development
APP_PORT=3001
# Clave para firmar sesiones/tokens. Genera una aleatoria larga.
APP_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga

# --- Cifrado de secretos en BD (AES-256-GCM) ---
# Clave maestra de 32 bytes en base64. Genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DBKEEPER_MASTER_KEY=

# --- Base de datos de metadatos (única conexión que no puede vivir en la BD) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dbkeeper

# --- Broker de tareas / tiempo real (se usa desde la Etapa 4) ---
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=info
