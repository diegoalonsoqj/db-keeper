# DBKeeper — variables de entorno (bootstrap mínimo, ver spec §13).
# Copia este archivo a `.env` y completa los valores. NUNCA subas `.env` al repo.
# Todo lo demás (credenciales de instancias, SMTP, Telegram, gcloud) vive cifrado en la BD.

# --- Aplicación ---
APP_ENV=development
APP_PORT=3001
# Clave para firmar sesiones/tokens. Genera una aleatoria larga.
APP_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga

# --- Cifrado de secretos en BD (AES-256-GCM) ---
# Clave maestra de 32 bytes en base64. Genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DBKEEPER_MASTER_KEY=

# --- Base de datos de metadatos (única conexión que no puede vivir en la BD) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dbkeeper

# --- Broker de tareas / tiempo real (se usa desde la Etapa 4) ---
REDIS_URL=redis://localhost:6379/0

# --- Motor de backups (Etapa 4, fase 2) ---
# Fallback de la carpeta de dumps locales: el destino real se define en el módulo
# Almacenamiento (destino local por defecto). Solo se usa si no hay ninguno.
# Se resuelve contra apps/api en dev/start; por defecto /backups en la raíz (gitignored).
BACKUP_DIR=../../backups
# Rutas a los binarios de dump si no están en el PATH.
PG_DUMP_PATH=pg_dump
MYSQLDUMP_PATH=mysqldump
MONGODUMP_PATH=mongodump
# Tiempos de backup: solo el VALOR INICIAL. Se editan en Configuración → Backups
# (lo guardado allí tiene prioridad). Un dump se corta si no avanza en N minutos
# (configurable); BACKUP_TIMEOUT_MS es el tope total (mínimo efectivo 24 h).
BACKUP_TIMEOUT_MS=1800000
# Timeout por base de datos para el export de Cloud SQL (ms). Por defecto 6 h.
# Al agotarse, el export no se da por fallido: se sigue verificando en segundo plano.
CLOUDSQL_EXPORT_TIMEOUT_MS=21600000
# Cada cuánto se verifican los exports que superaron el timeout (ms). Por defecto 5 min.
CLOUDSQL_VERIFY_INTERVAL_MS=300000
# Tope absoluto de un export de Cloud SQL (ms); pasado esto se marca fallido. Por defecto 48 h.
CLOUDSQL_EXPORT_MAX_MS=172800000
# Prioridad (nice, 0-19) de pg_dump/mysqldump/mongodump: con CPU saturada cede a la API. 0 = normal.
DUMP_PROCESS_NICE=10

# --- Logging ---
# IP real del cliente (auditoría y límite de intentos de login). false = IP de la
# conexión (app servida directo). Detrás de un proxy: 1 (saltos) o la IP/subred del proxy.
TRUST_PROXY=false

LOG_LEVEL=info

# --- Servir el front desde la propia API (despliegue de un solo puerto, sin Nginx) ---
# Con SERVE_WEB=true, Express entrega el build del front y la UI queda en el mismo
# puerto que la API (APP_PORT). Requiere haber hecho `pnpm --filter @dbkeeper/web build`.
SERVE_WEB=false
# Ruta al build del front. Relativa se resuelve contra apps/api (cwd de start).
WEB_DIST_PATH=../web/dist
# Marca `secure` en la cookie de sesión. Sin definir = sigue a APP_ENV (true en
# producción). En despliegue interno por HTTP (sin TLS) DEBE ser false, o el navegador
# descarta la cookie y tras el login todo responde "No autenticado".
COOKIE_SECURE=false

# --- AD / LDAP (opcional; preferentemente se configura en el módulo Settings, BD) ---
# Estas variables son solo un FALLBACK si LDAP no está configurado en Settings.
# Si todo queda vacío, el login AD queda deshabilitado y solo funcionan los usuarios locales.
LDAP_URL=                      # ldaps://dc.empresa.com:636
LDAP_BIND_DN=                  # CN=svc-dbkeeper,OU=Servicios,DC=empresa,DC=com
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=              # OU=Usuarios,DC=empresa,DC=com
LDAP_USER_FILTER=(sAMAccountName={{username}})
LDAP_TLS_REJECT_UNAUTHORIZED=true

# --- Bootstrap del superadmin (solo lo usa `pnpm --filter @dbkeeper/api seed`) ---
BOOTSTRAP_ADMIN_USERNAME=admin
# Si se deja vacío, el seed genera una contraseña temporal aleatoria y la imprime.
BOOTSTRAP_ADMIN_PASSWORD=
