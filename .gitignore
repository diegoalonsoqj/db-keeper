# Dependencies
node_modules/
.pnpm-store/
# Este monorepo usa pnpm: ignora locks de otros gestores para evitar ruido/confusión.
package-lock.json
yarn.lock

# Build output
dist/
build/
*.tsbuildinfo

# Env
.env
.env.*
!.env.example

# Claves de service accounts / secretos (nunca versionar). Se pegan en la UI,
# no se leen del disco; el archivo solo sirve para copiar su contenido.
keys/
*.sa.json

# Logs
logs/
*.log

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Backups generados localmente (nunca versionar dumps).
# Anclado a la raíz para no ignorar el módulo apps/api/src/modules/backups/.
/backups/
*.sql.gz
*.bak
*.archive
