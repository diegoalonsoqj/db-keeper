{
  "name": "@dbkeeper/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts"
  },
  "dependencies": {
    "@dbkeeper/shared": "workspace:*",
    "@google-cloud/storage": "^7.19.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron-parser": "^5.5.0",
    "express": "^5.1.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "jose": "^5.9.6",
    "ldapts": "^7.2.1",
    "mongodb": "^7.2.0",
    "mssql": "^12.5.5",
    "mysql2": "^3.22.4",
    "nodemailer": "^8.0.10",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
